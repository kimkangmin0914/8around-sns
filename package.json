{
  "name": "around",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "check": "prettier --check . && eslint . && tsc --noEmit && vitest run --project unit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:start": "npx --yes supabase@2.120.0 start",
    "db:stop": "npx --yes supabase@2.120.0 stop",
    "db:reset": "npx --yes supabase@2.120.0 db reset",
    "db:env": "node scripts/local-env.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
